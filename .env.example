# GEMINI_API_KEY: Optional. Only used as a fallback for /api/extract-document
GEMINI_API_KEY=

# APP_URL: Not required outside AI Studio's own hosting.
APP_URL=

# OAuth2 credentials for Gemini Enterprise / Discovery Engine server-side token exchange
oauth_client_id=
oauth_client_secret=
oauth_refresh_token=

# Discovery Engine / Agent specifications (KPSTI Sabah Technical agent)
PROJECT_NUMBER=
ENGINE_ID=
ASSISTANT_ID=
AGENT_ID=

# VITE_ prefixed aliases
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_CLIENT_SECRET=
VITE_OAUTH_REFRESH_TOKEN=
